  "license": "MIT",
  "namespace": "RaspAP\\Plugins\\MPNetWire",
  "configuration": [],
  "default_locale": "en_US",
  "dependencies": {},
  "icon": "fas fa-gamepad",
  "install_path": "plugins",
  "manifest_version": "1.0",
  "sudoers": [
    "www-data ALL=(ALL) NOPASSWD:/bin/systemctl start mpnet-watch.service",
