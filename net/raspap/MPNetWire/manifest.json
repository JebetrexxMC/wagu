  "description": "MP LAN-party hotspot: mpnetd status and relay control for SA-MP / open.mp / MP servers",
  "author": "JebetrexxMC",
  "author_uri": "https://github.com/JebetrexxMC",
  "plugin_uri": "https://github.com/JebetrexxMC/wagu/tree/main/net/raspap",
