# Copy to .env (never commit .env). MP Railway keeps these in /etc/mp-railway/discordpy-bot.env instead.
DISCORD_TOKEN=
AUTH_PRIVATE_KEY=
# optional
VERIFY_CHANNEL=verification
GLOBAL_SYNC=0
# 5.00.05 optional: keep the accounts on GitHub (encrypted, branch mp-railway-data) so a redeploy never resets them
DATA_REPO_TOKEN=
DATA_REPO=JebetrexxMC/discordpy-bot
