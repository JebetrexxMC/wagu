{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MP Launcher",
  "version": "1.0.0",
  "identifier": "net.thirtyfox.mp.launcher",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "MP Launcher", "width": 1100, "height": 700, "minWidth": 820, "minHeight": 520, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "shortDescription": "MP Launcher for PC",
    "longDescription": "SA-MP / open.mp server browser with MP Crossplay 24/7, pings and one-click join."
  }
}
