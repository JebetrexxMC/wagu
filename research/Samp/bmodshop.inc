					{
						if (vehiclemodinfo[vehiclevalidmods[modelid-400][c]-1000][vmod_type] == COMPONENT_TYPE_NONE) continue;
						if (vehiclemodinfo[vehiclevalidmods[modelid-400][c]-1000][vmod_type] == pmodshopcata[playerid]-1)
						{
							temp1 ++;
							if (temp1 < MAX_MENU_ITEMS) continue;

							AddMenuItem(pmodshopmenu[playerid], 0, vehiclemodinfo[vehiclevalidmods[modelid-400][c]-1000][vmod_name]);

							if (vcompids[vehicleid][pmodshopcata[playerid]-2] == vehiclevalidmods[modelid-400][c])
