static ShowTextDrawSetTimer(playerid, Text:textdraw, delay)
{
	TextDrawShowForPlayer(playerid, textdraw);
	ptextdraw[playerid] = textdraw;
	textdtimer[playerid] = SetTimerEx("StopTextDrawForPlayer", delay, false, "d", playerid);
}

forward StopTextDrawForPlayer(playerid);

public StopTextDrawForPlayer(playerid)
{
	TextDrawHideForPlayer(playerid, ptextdraw[playerid]);
	ptextdraw[playerid] = Text:INVALID_TEXT_DRAW;
	KillTimer(textdtimer[playerid]);
	textdtimer[playerid] = -1;
}

stock bool:IsVehicleModelBicycle(modelid)
{
	switch (modelid)
	{
		case 481, 509, 510: return true;
	}
	return false;
}

stock bool:IsVehicleModelHelicopter(modelid)
{
	switch (modelid)
	{
		case 417, 425, 447, 469, 487, 488, 497, 548, 563: return true;
	}
	return false;
}

stock bool:IsVehicleModelPlane(modelid)
{
	switch (modelid)
	{
		case 460, 476, 511, 512, 513, 519, 520, 553, 577, 592, 593: return true;
	}
	return false;
}

stock bool:IsVehicleModelAircraft(modelid)
{
	if (IsVehicleModelHelicopter(modelid) || IsVehicleModelPlane(modelid)) return true;
	return false;
}

stock bool:IsVehicleModelBoat(modelid)
{
	switch (modelid)
	{
		case 430, 446, 452, 454, 453, 472, 473, 484, 493, 595: return true;
	}
	return false;
}

// Natives

stock BMS_AddVehicleComponent(vehicleid, componentid)
{
	if (GetVehicleModel(vehicleid) == 0 || componentid < 1000 || componentid > 1193) return 0;
	if (vehiclemodinfo[componentid-1000][vmod_linkto] != 0)
	{
		AddVehicleComponent(vehicleid, vehiclemodinfo[componentid-1000][vmod_linkto]);
	}
	return AddVehicleComponent(vehicleid, componentid);
}

stock BMS_RemoveVehicleComponent(vehicleid, componentid)
{
	if (GetVehicleModel(vehicleid) == 0 || componentid < 1000 || componentid > 1193) return 0;;
	if (vehiclemodinfo[componentid-1000][vmod_linkto] != 0)
	{
		RemoveVehicleComponent(vehicleid, vehiclemodinfo[componentid-1000][vmod_linkto]);
	}
	return RemoveVehicleComponent(vehicleid, componentid);
}

stock BMS_GetVehicleComponentType(component)
{
	if (component < 1000 || component >= 1000 + MAX_COMPONENTS)
	{
		return 0;
	}
	return vehiclemodinfo[componentid-1000][vmod_name]);
}

stock BMS_GetVehicleComponentInSlot(vehicleid, CARMODTYPE:slot)
{
	if (vehicleid < 1 || vehicleid >= MAX_VEHICLES || _:slot <= 0 || _:slot > MAX_COMPONENT_TYPES)
	{
		return 0;
	}
	return vcompids[vehicleid-1][_:slot];
}

stock BMS_GetVehiclePaintjob(vehicleid)
{
	if (vehicleid < 1 || vehicleid >= MAX_VEHICLES)
	{
		return 0;
	}
	return vpaintjob[vehicleid-1];
}

stock BMS_DestroyVehicle(vehicleid)
{
	vpaintjob[vehicleid-1] = 3;

	for (new c = 0; c < MAX_COMPONENT_TYPES; c++)
	{
	    vcompids[vehicleid-1][c] = COMPONENT_TYPE_NONE;
	}
	return DestroyVehicle(vehicleid);
}

