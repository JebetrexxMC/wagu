public OnPlayerConnect(playerid)
{
	inmodshop[playerid] = MS_TYPE_NONE;

	return BMS_OnPlayerConnect(playerid);
}

public OnPlayerDisconnect(playerid, reason)
{
	if (pmodshopmenu[playerid] != Menu:INVALID_MENU)
	{
//		HideMenuForPlayer(pmodshopmenu[playerid], playerid);
		DestroyMenu(pmodshopmenu[playerid]);
		pmodshopmenu[playerid] = Menu:INVALID_MENU;
	}

	if (ptextdraw[playerid] != Text:INVALID_TEXT_DRAW)
	{
		ptextdraw[playerid] = Text:INVALID_TEXT_DRAW;
		if (textdtimer[playerid] != -1)
		{
			KillTimer(textdtimer[playerid]);
			textdtimer[playerid] = -1;
		}
	}

	return BMS_OnPlayerDisconnect(playerid, reason);
}

public OnPlayerStateChange(playerid, PLAYER_STATE:newstate, PLAYER_STATE:oldstate)
{
	if (oldstate == PLAYER_STATE_DRIVER)
	{
		if (pmodshopmenu[playerid] != Menu:INVALID_MENU)
		{
			HideMenuForPlayer(pmodshopmenu[playerid], playerid);
			DestroyMenu(pmodshopmenu[playerid]);
			pmodshopmenu[playerid] = Menu:INVALID_MENU;
		}
		if (ptextdraw[playerid] == modshoptxt1)
		{
			TextDrawHideForPlayer(playerid, modshoptxt1);
			if (textdtimer[playerid] != -1)
			{
				KillTimer(textdtimer[playerid]);
				textdtimer[playerid] = -1;
			}
		}
		else if (ptextdraw[playerid] == modshoptxt2)
		{
			TextDrawHideForPlayer(playerid, modshoptxt2);
			if (textdtimer[playerid] != -1)
			{
				KillTimer(textdtimer[playerid]);
				textdtimer[playerid] = -1;
			}
		}
		else if (ptextdraw[playerid] == modshoptxt3)
		{
			TextDrawHideForPlayer(playerid, modshoptxt3);
			if (textdtimer[playerid] != -1)
			{
				KillTimer(textdtimer[playerid]);
				textdtimer[playerid] = -1;
			}
		}
	}

	return BMS_OnPlayerStateChange(playerid, newstate, oldstate);
}

public OnVehicleSpawn(vehicleid)
{
	vpaintjob[vehicleid-1] = 3;

	for (new c = 0; c < MAX_COMPONENT_TYPES; c++)
	{
		vcompids[vehicleid-1][c] = COMPONENT_TYPE_NONE;
	}

	return BMS_OnVehicleSpawn(vehicleid);
}

public OnPlayerSelectedMenuRow(playerid, row)
{
	if (GetPlayerMenu(playerid) == pmodshopmenu[playerid])
	{
		if (pmodshopstage[playerid] == 0)
		{
			DestroyMenu(pmodshopmenu[playerid]);

			if (pmodshopitems[playerid][row] == 0)
			{
				pmodshopstage[playerid] = 2;
				pmodshopcata[playerid] = pmodshopitems[playerid][row];
				pmodshopmenu[playerid] = CreateMenu("Upgrades", 2, 29.0, 145.0, 186.0, 186.0);
				SetMenuColumnHeader(pmodshopmenu[playerid], 0, "Upgrade");
				SetMenuColumnHeader(pmodshopmenu[playerid], 1, "Cost");

				AddMenuItem(pmodshopmenu[playerid], 0, "Respray");
				AddMenuItem(pmodshopmenu[playerid], 1, "$150");
			}
			else if (pmodshopitems[playerid][row] == 1)
			{
				pmodshopstage[playerid] = 1;
				pmodshopcata[playerid] = pmodshopitems[playerid][row];
				pmodshopmenu[playerid] = CreateMenu("Upgrades", 1, 29.0, 145.0, 186.0, 0.0);

				AddMenuItem(pmodshopmenu[playerid], 0, "Paintjob 1");
				new vehicleid = GetPlayerVehicleID(playerid);
				if (GetVehicleModel(vehicleid) != 483)
				{
					AddMenuItem(pmodshopmenu[playerid], 0, "Paintjob 2");
					AddMenuItem(pmodshopmenu[playerid], 0, "Paintjob 3");
				}

				if (vpaintjob[vehicleid] != 3)
				{
					DisableMenuRow(pmodshopmenu[playerid], vpaintjob[vehicleid]);
				}
			}
			else
			{
				pmodshopstage[playerid] = 1;
				pmodshopcata[playerid] = pmodshopitems[playerid][row];
				pmodshopmenu[playerid] = CreateMenu("Upgrades", 1, 29.0, 145.0, 186.0, 0.0);

				new vehicleid = GetPlayerVehicleID(playerid);

				if (pmodshopitems[playerid][row] - 1 != COMPONENT_TYPE_STEREO && pmodshopitems[playerid][row] - 1 != COMPONENT_TYPE_HYDRAULICS)
				{
					new Float:vX, Float:vY, Float:vZ;
					GetVehiclePos(vehicleid, vX, vY, vZ);

					new Float:camX, Float:camY, Float:camZ;
					camX = vX + compoffsets[pmodshopitems[playerid][row]-2][c_vtocam_x];
					camY = vY + compoffsets[pmodshopitems[playerid][row]-2][c_vtocam_y];
					camZ = vZ + compoffsets[pmodshopitems[playerid][row]-2][c_vtocam_z];

					SetPlayerCameraPos(playerid, camX, camY, camZ);
					SetPlayerCameraLookAt(playerid, camX + compoffsets[pmodshopitems[playerid][row]-2][c_camtolook_x], camY + compoffsets[pmodshopitems[playerid][row]-2][c_camtolook_y], camZ + compoffsets[pmodshopitems[playerid][row]-2][c_camtolook_z]);
				}

				new modelid = GetVehicleModel(vehicleid);
				for (new c = 1, temp1 = 0; c <= vehiclevalidmods[modelid-400][0]; c++)
				{
					if (vehiclemodinfo[vehiclevalidmods[modelid-400][c]-1000][vmod_type] == COMPONENT_TYPE_NONE) continue;
					if (vehiclemodinfo[vehiclevalidmods[modelid-400][c]-1000][vmod_type] == pmodshopcata[playerid]-1)
					{
						AddMenuItem(pmodshopmenu[playerid], 0, vehiclemodinfo[vehiclevalidmods[modelid-400][c]-1000][vmod_name]);

						if (vcompids[vehicleid][pmodshopcata[playerid]-2] == vehiclevalidmods[modelid-400][c])
						{
							DisableMenuRow(pmodshopmenu[playerid], temp1);
						}

						pmodshopitems[playerid][temp1] = vehiclevalidmods[modelid-400][c];
						temp1 ++;
						if (temp1 == MAX_MENU_ITEMS-1)
						{
							AddMenuItem(pmodshopmenu[playerid], 0, "Next >>");
							pmodshoppage[playerid] = 0;
							break;
						}
					}
				}
			}
			ShowMenuForPlayer(pmodshopmenu[playerid], playerid);
		}
		else if (pmodshopstage[playerid] == 1)
		{
			new vehicleid = GetPlayerVehicleID(playerid);

			if ((pmodshoppage[playerid] == 0 && row == MAX_MENU_ITEMS - 1) || (pmodshoppage[playerid] == 1 && row == 0))
