								AddMenuItem(pmodshopmenu[playerid], 0, "Next >>");
								break;
							}
						}
					}
					pmodshoppage[playerid] = 0;
				}
			}
			else
			{
				if (pmodshopcata[playerid] == 0)
				{
//
				}
				else if (pmodshopcata[playerid] == 1)
				{
					if (vpaintjob[vehicleid] != row)
					{
						DestroyMenu(pmodshopmenu[playerid]);

						pmodshopstage[playerid] = 2;
						pmodshopmenu[playerid] = CreateMenu("Upgrades", 2, 29.0, 145.0, 186.0, 186.0);
						SetMenuColumnHeader(pmodshopmenu[playerid], 0, "Upgrade");
						SetMenuColumnHeader(pmodshopmenu[playerid], 1, "Cost");

						if (row == 0)
						{
							AddMenuItem(pmodshopmenu[playerid], 0, "Paintjob 1");
						}
						else if (row == 1)
						{
							AddMenuItem(pmodshopmenu[playerid], 0, "Paintjob 2");
						}
						else
						{
							AddMenuItem(pmodshopmenu[playerid], 0, "Paintjob 3");
						}
						AddMenuItem(pmodshopmenu[playerid], 1, "$500");
						pmodshopmod[playerid] = row;

						ChangeVehicleColours(vehicleid, 1, 1);
						ChangeVehiclePaintjob(vehicleid, row);
					}
				}
				else
				{
					if (pmodshopitems[playerid][row] >= 1000)
					{
						if (vcompids[vehicleid][pmodshopcata[playerid]-2] != pmodshopitems[playerid][row])
						{
							DestroyMenu(pmodshopmenu[playerid]);

							pmodshopstage[playerid] = 2;
							pmodshopmenu[playerid] = CreateMenu("Upgrades", 2, 29.0, 145.0, 186.0, 186.0);
							SetMenuColumnHeader(pmodshopmenu[playerid], 0, "Upgrade");
							SetMenuColumnHeader(pmodshopmenu[playerid], 1, "Cost");

							AddMenuItem(pmodshopmenu[playerid], 0, vehiclemodinfo[pmodshopitems[playerid][row]-1000][vmod_name]);
							new tmp[8];
							format(tmp, 8, "$%d", vehiclemodinfo[pmodshopitems[playerid][row]-1000][vmod_cost]);
							AddMenuItem(pmodshopmenu[playerid], 1, tmp);

							pmodshopmod[playerid] = pmodshopitems[playerid][row];

							if (vcompids[vehicleid][pmodshopcata[playerid]-2] != COMPONENT_TYPE_NONE)
							{
								RemoveVehicleComponent(vehicleid, vcompids[vehicleid][pmodshopcata[playerid]-2]);
							}
							AddVehicleComponent(vehicleid, pmodshopitems[playerid][row]);
						}
						else
						{
							ShowTextDrawSetTimer(playerid, modshoptxt2, 5000);
							PlayerPlaySound(playerid, 1055, 0.0, 0.0, 0.0);
						}
					}
					else
					{
						ShowTextDrawSetTimer(playerid, modshoptxt3, 5000);
						PlayerPlaySound(playerid, 1055, 0.0, 0.0, 0.0);
					}
				}
			}
			ShowMenuForPlayer(pmodshopmenu[playerid], playerid);
		}
		else if (pmodshopstage[playerid] == 2)
		{
			new vehicleid = GetPlayerVehicleID(playerid);

			if (pmodshopcata[playerid] == 0)
			{
				if (GetPlayerMoney(playerid) < 150)
				{
					ShowMenuForPlayer(pmodshopmenu[playerid], playerid);
					ShowTextDrawSetTimer(playerid, modshoptxt1, 5000);
					PlayerPlaySound(playerid, 1055, 0.0, 0.0, 0.0);
					return 1;
				}

				RepairVehicle(vehicleid);
				
				new modelid = GetVehicleModel(vehicleid);
				if (colorused[modelid-400] < vcolarray[modelid-400][0][1]) colorused[modelid-400] ++;
				else colorused[modelid-400] = 1;
				ChangeVehicleColours(vehicleid, vcolarray[modelid-400][colorused[modelid-400]][0], vcolarray[modelid-400][colorused[modelid-400]][1]);

				CallRemoteFunction("OnVehicleRespray2", "iiii", playerid, vehicleid, vcolarray[modelid-400][colorused[modelid-400]][0], vcolarray[modelid-400][colorused[modelid-400]][1]);

				GivePlayerMoney(playerid, -150);
				PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);
			}
			else if (pmodshopcata[playerid] == 1)
			{
				if (GetPlayerMoney(playerid) < 500)
				{
					ShowMenuForPlayer(pmodshopmenu[playerid], playerid);
					ShowTextDrawSetTimer(playerid, modshoptxt1, 5000);
					PlayerPlaySound(playerid, 1055, 0.0, 0.0, 0.0);
					return 1;
				}

				vpaintjob[vehicleid] = pmodshopmod[playerid];

				CallRemoteFunction("OnVehiclePaintjob2", "iii", playerid, vehicleid, pmodshopmod[playerid]);

				RepairVehicle(vehicleid);

				GivePlayerMoney(playerid, -500);
				PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);
			}
			else
			{
				if (GetPlayerMoney(playerid) < vehiclemodinfo[pmodshopmod[playerid]-1000][vmod_cost])
				{
					ShowMenuForPlayer(pmodshopmenu[playerid], playerid);
					ShowTextDrawSetTimer(playerid, modshoptxt1, 5000);
					PlayerPlaySound(playerid, 1055, 0.0, 0.0, 0.0);
					return 1;
				}

				vcompids[vehicleid][vehiclemodinfo[pmodshopmod[playerid]-1000][vmod_type]-1] = pmodshopmod[playerid];

				CallRemoteFunction("OnVehicleMod2", "iii", playerid, vehicleid, pmodshopmod[playerid]);

				GivePlayerMoney(playerid, -vehiclemodinfo[pmodshopmod[playerid]-1000][vmod_cost]);
				PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);
			}

			DestroyMenu(pmodshopmenu[playerid]);
			pmodshopstage[playerid] = 0;
			pmodshopmenu[playerid] = CreateMenu("Upgrades", 1, 29.0, 145.0, 186.0, 0.0);

			new Float:vX, Float:vY, Float:vZ;
			GetVehiclePos(vehicleid, vX, vY, vZ);

			new Float:camX, Float:camY, Float:camZ; 
			camX = vX + C_DEF_VTOCAM_X_OSS;
			camY = vY + C_DEF_VTOCAM_Y_OSS;
			camZ = vZ + C_DEF_VTOCAM_Z_OSS;

			SetPlayerCameraPos(playerid, camX, camY, camZ);
			SetPlayerCameraLookAt(playerid, camX + C_DEF_CAMTOLOOK_X_OSS, camY + C_DEF_CAMTOLOOK_Y_OSS, camZ + C_DEF_CAMTOLOOK_Z_OSS);

			new modelid = GetVehicleModel(vehicleid);

			new temp1 = 0;

			AddMenuItem(pmodshopmenu[playerid], 0, "Respray");
			pmodshopitems[playerid][temp1] = 0;
			temp1 ++;
			switch (modelid)
			{
				case 483, 534, 535, 536, 558, 559, 560, 561, 562, 565, 566, 567, 575, 576: {
					AddMenuItem(pmodshopmenu[playerid], 0, "Paintjob");
					pmodshopitems[playerid][temp1] = 1;
					temp1 ++;
				}
				default: {

				}
			}
			new c, ctypecount[MAX_COMPONENT_TYPES + 1];
			for (c = 1; c <= vehiclevalidmods[modelid-400][0]; c++)
			{
				if (vehiclemodinfo[vehiclevalidmods[modelid-400][c]-1000][vmod_type] == COMPONENT_TYPE_NONE) continue;
				ctypecount[vehiclemodinfo[vehiclevalidmods[modelid-400][c]-1000][vmod_type]] ++;
			}
			for (c = 1; c <= MAX_COMPONENT_TYPES; c++)
			{
				if (ctypecount[c] == 0) continue;
				AddMenuItem(pmodshopmenu[playerid], 0, comptypenames[c-1]);
				pmodshopitems[playerid][temp1] = c+1;
				temp1 ++;
			}
			ShowMenuForPlayer(pmodshopmenu[playerid], playerid);
		}
	}

	return BMS_OnPlayerSelectedMenuRow(playerid, row);
}

